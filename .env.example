# ──────────────────────────────────────────────────────────────────
# Kitesurfing Dakhla — Environment Variables
# Kopieren nach .env (lokal) oder in Dokploy-UI eintragen (production).
# ──────────────────────────────────────────────────────────────────

# ─── Payload CMS ──────────────────────────────────────────────────
# Eigenes Secret generieren:
#   openssl rand -base64 32
PAYLOAD_SECRET=

# Postgres-Verbindung. Lokal via docker-compose (Host-Port 5436,
# 5432/5435 sind von churfirsten/katharinas belegt):
#   docker compose up -d
DATABASE_URI=postgresql://payload:payload@localhost:5436/kitesurfing

# ─── Frontend ─────────────────────────────────────────────────────
# Lokal http://localhost:3000, in Production die Domain.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Production-Site-URL (Sitemap, Canonical, OpenGraph).
NEXT_PUBLIC_SITE_URL=https://kitesurfingdakhla.com

# ─── R2 Media-Storage (Webtree Shared-Bucket) ─────────────────────
# Production-Bucket für Payload-Media-Uploads. Credentials siehe
# 1Password "Cloudflare R2 — webtree-media". Lokal weglassen → Payload
# fällt auf Filesystem-Storage (media/) zurück.
S3_BUCKET=webtree-media
S3_ENDPOINT=https://256f2599fd4fde46bb7b18d7b1ad75ae.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://media.webtree.ch
S3_PREFIX=kitesurfing-dakhla
