{
  "name": "client-kitesurfing-dakhla",
  "version": "0.1.0",
  "description": "Kitesurfing Dakhla — Website mit Payload CMS by Webtree GmbH",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" \"*.{md,json,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "type-check": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "db:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "db:fresh": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:fresh",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env scripts/seed.ts",
    "ensure-admin": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env scripts/ensure-admin.ts",
    "create-editor": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env scripts/create-editor.ts",
    "preflight": "pnpm type-check && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/live-preview-react": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/plugin-seo": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-s3": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.10.0",
    "next": "15.5.21",
    "payload": "3.86.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sharp": "0.35.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.21",
    "prettier": "^3.4.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@swc/core",
      "unrs-resolver"
    ],
    "overrides": {
      "dompurify": ">=3.4.12",
      "postcss": ">=8.5.12",
      "sharp": ">=0.35.0",
      "esbuild": ">=0.25.0"
    }
  },
  "engines": {
    "node": "^20 || ^22"
  },
  "packageManager": "pnpm@10.33.2"
}
